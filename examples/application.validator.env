# Copy to operator/application.env and replace the origin.
# Never enable NIGHTBUOY_TEST_MODE on a public deployment.
NIGHTBUOY_PUBLIC_URL=https://forum.example.org
NIGHTBUOY_CONSENSUS_RPC=http://127.0.0.1:26657
NIGHTBUOY_CONSENSUS_GENESIS=/config/genesis.json
NIGHTBUOY_ABCI_LISTEN=127.0.0.1:26658
NIGHTBUOY_PROVIDERS_FILE=/config/providers.json
NIGHTBUOY_REPLICAS_FILE=/config/replicas.json
# For the Tor profile, use the generated http://<v3-address>.onion origin
# and route external application HTTP/storage requests through Tor:
# NIGHTBUOY_SOCKS_PROXY=socks5h://127.0.0.1:9050
